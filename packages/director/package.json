{
  "name": "@swivel/director",
  "version": "0.1.0",
  "private": true,
  "description": "Break-aware, preference-aware auto-director for multi-game live sports viewing. Pure TypeScript, no platform dependencies.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "MIT-0",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "headless": "tsx scripts/runHeadless.ts",
    "demo-timeline": "tsx scripts/demoTimeline.ts",
    "find-slate": "tsx scripts/findSlate.ts",
    "find-demo": "tsx scripts/findDemo.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.0"
  },
  "keywords": [
    "sports",
    "live-tv",
    "fire-tv",
    "vega",
    "basketball",
    "win-probability",
    "recommender",
    "second-screen",
    "multiview"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
